{
  "name": "pokbase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@electric-sql/pglite-socket": "0.2.18",
    "@mastra/core": "1.82.0",
    "@mastra/libsql": "1.29.0",
    "@mastra/mcp": "2.8.0",
    "@mastra/memory": "1.41.0",
    "@mastra/pg": "1.35.0",
    "chokidar": "6.0.0",
    "dotenv": "18.0.9",
    "gray-matter": "4.0.3",
    "js-yaml": "5.5.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "mastra": "1.38.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "scripts": {
    "dev": "mastra dev --dir src/mastra",
    "seed": "tsx src/seed.ts",
    "export": "tsx src/export.ts",
    "submit": "tsx src/ingest/submit.ts",
    "watch": "tsx src/ingest/watch.ts",
    "worker": "tsx src/ingest/worker.ts",
    "review": "tsx src/review.ts",
    "inspect": "tsx src/inspect.ts",
    "kb": "tsx src/cli.ts",
    "ask": "tsx src/cli.ts ask",
    "test": "vitest run",
    "test:llm": "LLM_TESTS=1 vitest run",
    "test:pg": "STORE=pg vitest run && tsx src/parity.ts",
    "eval": "tsx eval/run-eval.ts",
    "reset": "tsx src/reset.ts",
    "typecheck": "tsc --noEmit -p .",
    "parity": "tsx src/parity.ts",
    "mcp": "tsx src/mcp/stdio.ts",
    "mcp:smoke": "tsx src/mcp/smoke.ts"
  }
}
