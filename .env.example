# Model used by the ingest and reader agents, as a Mastra model-router id.
# Leave MODEL unset (or set MODEL=mock) to use the scripted mock model (no key needed).
# MODEL=anthropic/claude-sonnet-5-5
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Knowledge store: libsql (default, ./data/knowledge.db) or pg (PGlite served over a local socket)
STORE=libsql

# Optional: hold every Knowledge write for human approval (see `npm run review`)
REVIEW=off
